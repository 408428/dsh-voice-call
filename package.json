{
  "name": "dsh-voice-call",
  "version": "0.3.0",
  "private": false,
  "description": "WeChat-style voice call for DeepSeek Harness: a sidebar call button, a live avatar that speaks, local speech recognition and synthesis with a cloud fallback, characters with their own voice and picture, and a mouth that moves with the audio",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "piper_worker.py",
    "lp_worker.py",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "xtts_worker.py",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "voice",
    "tts",
    "asr",
    "liveportrait",
    "piper",
    "xtts",
    "avatar"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liyanze/dsh-voice-call.git"
  },
  "author": "liyanze",
  "homepage": "https://github.com/liyanze/dsh-voice-call#readme"
}
